{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paystream",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script until something needs a server (D10). Static
  // requests are free and don't count against the account's shared daily Worker quota.
  // Build first (`npm run deploy` does both); the directory must exist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
